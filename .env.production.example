# ─────────────────────────────────────────────────────────────────────────────
# Zeno — modèle de configuration de production.
# Copier en .env sur le serveur, puis remplir les <valeurs>.
# Ne JAMAIS committer le .env rempli. Aucun secret dans ce fichier.
#
# Première installation :
#   cp .env.production.example .env
#   php artisan key:generate          # génère APP_KEY (voir l'avertissement plus bas)
#   php artisan migrate --force
#   php artisan zeno:user-create ...  # comptes réels
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=Zeno
APP_ENV=production
# Généré une seule fois par `php artisan key:generate`.
# ATTENTION : cette clé déchiffre les jetons d'API GLPI stockés en base.
# La changer rend les organisations existantes inutilisables. À sauvegarder.
APP_KEY=
# false en production, sans exception : true exposerait les clés d'API dans les stack traces.
APP_DEBUG=false
APP_URL=https://<domaine-interne>

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# warning ou error : en debug, les payloads métier (texte des demandes) partent dans les logs.
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# ─── Base de données (fournie par l'administration système) ───────────────────
DB_CONNECTION=pgsql
DB_HOST=<hôte>
DB_PORT=5432
DB_DATABASE=zeno
DB_USERNAME=zeno
DB_PASSWORD=<mot de passe>
# Si la base est sur une autre machine et que la liaison est chiffrée : require
DB_SSLMODE=prefer

# ─── Sessions, cache, file d'attente : tout en base, pas de Redis ─────────────
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Envoi d'emails (notification « ticket résolu », mots de passe oubliés) ───
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=<relais interne>
MAIL_PORT=587
MAIL_USERNAME=<compte ou null>
MAIL_PASSWORD=<mot de passe ou null>
MAIL_FROM_ADDRESS=zeno@<domaine>
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ─── Classification IA ───────────────────────────────────────────────────────
# openai = API OpenAI (défaut), claude = API Anthropic. Ne jamais mettre "local" en production :
# deploy.sh le refuse, et refuse aussi une OPENAI_API_KEY vide quand le moteur est openai.
AI_PROVIDER=openai
OPENAI_API_KEY=<clé d'API>
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# gpt-5.4-mini répond en ~2 s : au-delà de 10 s, le fallback mots-clés prend le relais.
OPENAI_TIMEOUT=10

# Uniquement si AI_PROVIDER=claude
CLAUDE_API_KEY=
# ID du modèle à vérifier avant mise en service (celui-ci date du dépôt).
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_VERIFY_SSL=true

SUPPORTIA_CONFIDENCE_THRESHOLD=0.7
# Timeout des moteurs claude et local. Sonnet dépasse souvent 5 s : en dessous de 20 s,
# le fallback mots-clés se déclenche à tort.
SUPPORTIA_AI_TIMEOUT=25
SUPPORTIA_GLPI_TIMEOUT=15

# Taille max par pièce jointe, en Ko. Doit rester sous upload_max_filesize / post_max_size (12M).
SUPPORTIA_ATTACHMENT_MAX_KB=10240

# ─── GLPI ────────────────────────────────────────────────────────────────────
# URL et jetons de l'instance GLPI ne sont PAS ici : ils sont chiffrés en base,
# par organisation (table organizations).
GLPI_VERIFY_SSL=true
# Toujours false en production : true simulerait les écritures GLPI.
GLPI_DRY_RUN=false

# Prévenir le demandeur par email quand GLPI passe son ticket en résolu.
# false si les notifications GLPI le font déjà (doublons).
ZENO_NOTIFY_RESOLVED=true
ZENO_ESTIMATE_MAX_HOURS=120
# Jours de conservation du contenu des logs IA (les compteurs de consommation sont gardés)
ZENO_AI_LOG_CONTENT_RETENTION_DAYS=90
